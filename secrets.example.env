# Make a copy of this file as `secrets.env` in the project root and populate it.

# These variables are read by `server.ts` (the Node/Express process), and by the
# Expo prebuild scripts.

###
# Server secrets
###

# Twilio account sid (ACxxxx)
TWILIO_ACCOUNT_SID=foobar

# Twilio API key sid (SKxxxx)
TWILIO_API_KEY_SID=SKfoobar

# Twilio API key secret
TWILIO_API_KEY_SECRET=foobar

# Twilio auth token. Used to validate incoming Twilio webhooks and the
# x-twilio-signature header on the ConversationRelay WebSocket upgrade.
TWILIO_AUTH_TOKEN=foobar

# Twilio TwiML App sid (APxxxx).
# The TwiML App's Voice Request URL must point to:
#   https://${CALLBACK_BASE_URL}/ai-conversation/twiml
TWILIO_TWIML_APP_SID=APfoobar

# OpenAI API key
OPENAI_API_KEY=sk-proj-foobar

###
# Client secrets
###

# Xcode apple team ID to use. If you prefer to set the signing team in Xcode,
# this value can be left blank.
IOS_APPLE_TEAM_ID=foobar

# Bundle ID used by Xcode to build the iOS application
IOS_BUNDLE_IDENTIFIER=com.foo.bar

# Package name used to build the Android application
ANDROID_PACKAGE=com.foo.bar
